# Copy to .env for `docker compose up` (the file is git-ignored).

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=veriflow
POSTGRES_PASSWORD=veriflow
POSTGRES_DB=veriflow

# --- Dashboard -------------------------------------------------------------
# Browser-visible API origin. Inlined into the Next.js build, so rebuild the
# web image after changing it. For a remote host use its public URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Officer sign-in -------------------------------------------------------
# Signs the session tokens. Change it before exposing the stack beyond
# localhost: a known secret lets anyone mint a valid officer token.
AUTH_SECRET_KEY=change-me-veriflow-local-signing-key
AUTH_TOKEN_TTL_MINUTES=480

# --- AI document intelligence (optional) -----------------------------------
# Leave blank to run every statutory rule and screen without extraction.
# The key is only used server-side; it is never sent to the browser.
GEMINI_API_KEY=
# Model used for lease-deed extraction. gemini-2.5-flash is no longer
# available to new API keys; gemini-3.6-flash is the verified working flash
# model (3.7/3.8 were returning 503/504 under demand at the time of writing).
GEMINI_MODEL=gemini-3.6-flash

# --- Rule 3 dwell thresholds (days) ----------------------------------------
SLA_THRESHOLD_DAYS=15
ESCALATION_L2_DAYS=30
ESCALATION_L3_DAYS=45
